PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# demo is for local testing only. Use yookassa before accepting real payments.
PAYMENT_MODE=demo
RESERVATION_MINUTES=15
DB_PATH=data/db.json

ADMIN_EMAIL=admin@slowy.local
ADMIN_PASSWORD=change-this-password-at-least-12-chars

# A random 32+ character value. Keep it stable: changing it makes existing
# encrypted inventory impossible to decrypt.
ENCRYPTION_KEY=replace-with-a-random-32-character-secret
COOKIE_SECURE=false
SEED_DEMO_INVENTORY=true
DEV_EMAIL_CODES=true
EMAIL_REQUIRED=false

# SMTP settings are required for real email verification.
# Example for Gmail: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mail@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=slowyshop <your-mail@gmail.com>

# Cloudflare Workers email provider. Workers cannot use normal SMTP ports.
# Set these as Wrangler secrets for the Worker deployment.
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=slowyshop <no-reply@slowy.lol>

# YooKassa production mode. Configure PAYMENT_MODE=yookassa and set the
# webhook URL in the YooKassa dashboard to /api/payments/yookassa/webhook.
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key

# Telegram applications bot. Leave TELEGRAM_BOT_TOKEN empty to disable it.
# Get a token from @BotFather. For local development use polling; production
# should use webhook on a public HTTPS URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-telegram-webhook-secret
# Numeric chat IDs that receive new application notifications, comma-separated.
TELEGRAM_ADMIN_CHAT_IDS=
# Optional numeric Telegram user IDs. They are also used as recipient chats.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_SESSION_MINUTES=30
TELEGRAM_APPLICATION_COOLDOWN_HOURS=24
# Allowed LOLZ profile hosts, comma-separated. No credentials are accepted.
LOLZ_ALLOWED_HOSTS=lolz.live,lolz.guru
